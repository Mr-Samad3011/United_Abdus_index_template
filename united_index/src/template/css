}

/* DOUBLE BORDER USING PSEUDO-ELEMENT */
.pdf-page::before {
  content: "";
  position: absolute;
  top: 0; 
  left: 0; 
  right: 0; 
  bottom: 0;
  border: 6px double black; /* or outline */
  pointer-events: none;
  box-sizing: border-box;
  z-index: 1; /* keeps border above background but below content */
}

/* CONTENT ABOVE BORDER */
.pdf-page > * {
  position: relative;
  z-index: 2; /* ensures logo and all content are in front */
}

