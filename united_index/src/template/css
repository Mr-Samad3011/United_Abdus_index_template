  /* Double border using inner div or pseudo-element */
}

.pdf-page::before {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  /* border: 6px double black; */
  pointer-events: none;
  box-sizing: border-box;
}

